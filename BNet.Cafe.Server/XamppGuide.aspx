<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="XamppGuide.aspx.cs" Inherits="BNet.Cafe.Server.XamppGuide" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8" />
    <!-- Removed maximum-scale / user-scalable=no so users can pinch-zoom on mobile -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="google" content="notranslate" />
    <meta name="robots" content="noarchive, noindex, nosnippet" />
    <link rel="icon" type="image/png" href="App/icon.png" />
    <title>XAMPP Not Detected - BNet Cafe</title>
    <% Response.Write(BNet.Cafe.Server.Services.FileCssHelper.StyleSheetVersion("Assets/XamppGuide/Style.css")); %>
</head>
<body>
    <!-- Inline SVG icons: no Font Awesome files, fonts, or CDN needed, so they always show -->
    <svg xmlns="http://www.w3.org/2000/svg" style="display: none" aria-hidden="true">
        <symbol id="i-warning" viewBox="0 0 24 24">
            <path d="M12 3.5 22 20.5H2z" />
            <path d="M12 10v4.5M12 17.6v.01" />
        </symbol>
        <symbol id="i-play" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9.5" />
            <path d="M10 8.5l5.5 3.5-5.5 3.5z" fill="currentColor" />
        </symbol>
        <symbol id="i-download" viewBox="0 0 24 24">
            <path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5" />
            <path d="M4 17v3h16v-3" />
        </symbol>
        <symbol id="i-info" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9.5" />
            <path d="M12 11v5.5M12 7.6v.01" />
        </symbol>
    </svg>

    <form id="form1" runat="server">
        <main class="card">
            <header class="card-header">
                <div class="status-icon">
                    <svg class="icon" aria-hidden="true">
                        <use href="#i-warning" />
                    </svg>
                </div>
                <div>
                    <h1>XAMPP Installation Not Detected</h1>
                    <p class="subtitle">BNet Cafe needs XAMPP installed in its default folder before it can run.</p>
                </div>
            </header>

            <div class="card-body">
                <div class="notice">
                    <p class="notice-title">
                        <svg class="icon" aria-hidden="true">
                            <use href="#i-info" />
                        </svg>
                        Important notice for users
                   
                    </p>
                    <p>
                        Watch and follow the official installation tutorial step by step.
                        Skipping steps or using the wrong configuration will cause errors.
                   
                    </p>
                </div>

                <div class="actions">
                    <a href="https://www.youtube.com/watch?v=uLtFC5AaoX0" target="_blank" rel="noopener noreferrer" class="btn btn-tutorial">
                        <svg class="icon" aria-hidden="true">
                            <use href="#i-play" />
                        </svg>
                        Watch Setup Tutorial
                    </a>
                    <a href="https://www.apachefriends.org/download.html" target="_blank" rel="noopener noreferrer" class="btn btn-download">
                        <svg class="icon" aria-hidden="true">
                            <use href="#i-download" />
                        </svg>
                        Download XAMPP
                    </a>
                </div>

                <h2>Setup steps</h2>
                <ol class="steps">
                    <li>Watch the setup tutorial video carefully before proceeding.</li>
                    <li>Download and install XAMPP, keeping the default installation path: <code>C:\xampp</code></li>
                    <li>Open the XAMPP Control Panel and start the required modules: <strong>Apache</strong> and <strong>MySQL</strong>.</li>
                    <li>Verify your setup by visiting <code>localhost/phpmyadmin</code> in your browser.</li>
                    <li>Refresh this page once XAMPP is fully configured and running.</li>
                    <li>After installing XAMPP, open <strong>Task Manager</strong> and end the <code>BNet.Cafe.Websocket</code> process so the changes are reflected in the database.
                       
                        <img src="data:image/png;base64," alt="End task BNet.Cafe.Websocket in Task Manager" class="step-image" />
                    </li>
                    <li>Open Xampp as Administrator <code>"C:\xampp\xampp-control.exe"</code> follow the tutorial</li>
                    <li>Re-run <code>BNet.Cafe.Websocket</code> to apply the changes.</li>
                </ol>

                <div class="footer-note">
                    <strong>Having trouble?</strong> Double-check the video tutorial steps, or verify that your
                    IIS Application Pool has read permissions to <code>C:\xampp</code>.
               
                </div>
            </div>
        </main>
    </form>
</body>
</html>
