<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
	<appSettings>
		<!-- ==================================================================== -->
		<!-- SERVER CONNECTION SETTINGS                                           -->
		<!-- ==================================================================== -->
		<!-- WebSocket real-time communication endpoint -->
		<add key="WebSocketUrl" value="" />

		<!-- BNet Cafe Server Web API base address -->
		<add key="AppUrl" value="" />

		<!-- ==================================================================== -->
		<!-- CLIENT IDENTIFICATION SETTINGS                                       -->
		<!-- ==================================================================== -->
		<!-- 
		  CLIENT NAME CONFIGURATION:
		  
		  1. TRADITIONAL SETUP (Local Hard Drive):
		     - Set explicit PC name here (e.g., value="PC-01").
		     - Do NOT use spaces (e.g., use "PC-01" instead of "PC 01").
		     
		  2. DISKLESS SETUP (Shared Master Image):
		     - Leave value empty (value="").
		     - Client name will auto-resolve from local IP address offset:
		       * 192.168.1.101 -> PC-01
		       * 192.168.1.102 -> PC-02
		       * 192.168.1.103 -> PC-03
		-->
		<add key="ClientName" value="" />

		<!-- ==================================================================== -->
		<!-- ADDITIONAL SETTINGS                                         -->
		<!-- ==================================================================== -->
		<add key="AccountCreationAllowed" value="True" />
		<add key="AutoShutDownInterval" value="300" />
		<add key="DesktopSlideShow" value="False" />
		<add key="ResetShutdownCountdown" value="False" />
		<add key="TimeZone" value="TAIPEI STANDARD TIME" />
		<add key="ComshopName" value="BNET CAFE" />
		<add key="EnableScheduler" value="false" />
		<add key="OpeningTime" value="08:00" />
		<add key="ClosingTime" value="21:00" />
		<add key="ClosingTimeMessage" value="The shop is now closing. Thank you!" />
		<add key="WarningTime" value="15" />
		<add key="WarningTimeMessage" value="The shop will close in few minutes." />
		<add key="EnableGameMenu" value="false" />
		<add key="LayoutMode" value="GRID" />
		<add key="EnableMinimize" value="true" />
		<add key="EnableWindowsKey" value="false" />
	</appSettings>
</configuration>